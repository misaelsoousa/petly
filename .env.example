# URL da API do Nexus (usada pelo site no servidor e no navegador)
NEXT_PUBLIC_NEXUS_API_URL=http://localhost:5144/api/

# Credenciais usadas apenas pelo `npm run seed` (nunca pelo site)
NEXUS_API_URL=http://localhost:5144/api/
NEXUS_SEED_EMAIL=
NEXUS_SEED_PASSWORD=

# Onde estão os projetos do Nexus (usado pelo `npm run dev:all`)
NEXUS_PANEL_DIR=../nexus
NEXUS_API_DIR=../nexus-api

# Painel do Nexus: o site repassa /admin para ele (ver next.config.ts)
NEXUS_PANEL_ORIGIN=http://localhost:3000
